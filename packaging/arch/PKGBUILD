# Maintainer: Linux Island contributors <farzahwalker46@gmail.com>
pkgname=linux-island
pkgver=0.1.0
pkgrel=1
pkgdesc="Dynamic Island-style status capsule for Linux desktops"
arch=('x86_64' 'aarch64')
url="https://github.com/farzah14/linux-island"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel' 'qt6-positioning' 'openssl' 'libxcb' 'xcb-util-cursor')
makedepends=('cmake' 'ninja' 'git')
optdepends=('python: AI quota and cookie-import helpers'
            'gnome-shell: native GNOME extension'
            'xorg-xprop: X11 and XWayland fullscreen detection')
source=("linux-island-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/linux-island-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
